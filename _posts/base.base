views:
  - type: table
    name: 表格
    filters:
      and:
        - file.ext == "md"
    order:
      - file.path
      - file.name
      - file.ext
      - categories
      - tags
      - author
      - date
      - file.links
    sort:
      - property: categories
        direction: ASC
      - property: file.path
        direction: ASC
    columnSize:
      note.categories: 212
      note.tags: 784
  - type: cards
    name: 视图
    cardSize: 310
    image: note.header-img
    imageAspectRatio: 0.45
