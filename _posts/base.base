filters:
  and:
    - file.ext == "md"
views:
  - type: table
    name: 表格
    order:
      - file.path
      - file.name
      - file.ext
      - categories
      - tags
      - author
      - date
      - file.links
      - header-style
      - header-img
    sort:
      - property: categories
        direction: ASC
      - property: file.path
        direction: ASC
    columnSize:
      note.categories: 155
      note.tags: 584
      file.links: 262
  - type: cards
    name: 视图
    cardSize: 310
    image: note.header-img
    imageAspectRatio: 0.45
